---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Publication from '../../components/Publication.astro';
import { profile } from '../../data/profile';
const publications = (await getCollection('publications')).sort((a,b) => +b.data.date-+a.data.date);
const years = [...new Set(publications.map(p => p.data.date.getUTCFullYear()))];
---
<Layout title="Publications" active="publications">
  <header class="page-header"><h1>Publications</h1><p>Work on robotic perception, multimodal sensing, and autonomous navigation.</p><a class="text-link" href={profile.socials[0].url}>Google Scholar</a></header>
  {years.map(year => { const papers = publications.filter(p => p.data.date.getUTCFullYear() === year); return <section class="publication-year" aria-labelledby={`year-${year}`}><h2 id={`year-${year}`}>{year}<span>{papers.length} {papers.length === 1 ? 'paper' : 'papers'}</span></h2>{papers.map(entry => <Publication entry={entry} expanded />)}</section>; })}
</Layout>
