---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Project from '../../components/Project.astro';
const projects = (await getCollection('projects')).sort((a,b) => a.data.order-b.data.order);
---
<Layout title="Projects" active="projects"><header class="page-header"><h1>Projects & collaborations</h1><p>Research across autonomous mobility, perception, and explainable models.</p></header><div class="project-grid projects-page">{projects.map(entry => <Project entry={entry} headingLevel={2} />)}</div></Layout>
