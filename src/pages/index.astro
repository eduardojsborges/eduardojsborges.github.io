---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Publication from '../components/Publication.astro';
import Project from '../components/Project.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { url } from '../lib/paths';
const publications = (await getCollection('publications')).sort((a, b) => +b.data.date - +a.data.date).filter(p => p.data.featured).slice(0, 3);
const projects = (await getCollection('projects')).sort((a,b) => a.data.order-b.data.order).filter(p => p.data.featured).slice(0, 3);
const news = (await getCollection('news')).sort((a,b) => +b.data.date - +a.data.date).slice(0,5);
const experience = (await getCollection('experience')).sort((a,b) => a.data.order-b.data.order);
const awards = (await getCollection('awards')).sort((a,b) => b.data.year-a.data.year);
const experiences = await Promise.all(experience.map(async entry => ({ entry, ...await render(entry) })));
---
<Layout>
  <section class="hero" aria-labelledby="intro-title">
    <div class="eyebrow"><span class="status-dot"></span>ROBOTICS · COMPUTER VISION · MULTIMODAL SENSING</div>
    <h1 id="intro-title">Understanding the world.<br /><span>Enabling autonomy.</span></h1>
    <p class="hero-intro">{profile.intro}</p>
    <div class="hero-actions"><a class="button" href={url('publications/')}>Explore my research <Icon size={16} /></a><a class="text-link" href={`mailto:${profile.email}`}>Get in touch <Icon size={14} /></a></div>
    <div class="hero-footnote"><span>BASED IN COIMBRA, PORTUGAL</span><span>SCROLL TO EXPLORE ↓</span></div>
  </section>
  <section class="section" aria-labelledby="research-title">
    <div class="section-heading"><div><span class="eyebrow">01 / RESEARCH FOCUS</span><h2 id="research-title">Perception in the real world<span class="accent">.</span></h2></div></div>
    <div class="interest-grid">{profile.interests.map((interest, i) => <div class="interest"><span class="interest-index">0{i + 1}</span><h3>{interest.title}</h3><p>{interest.description}</p></div>)}</div>
    <div class="skills"><span>TOOLS & METHODS</span>{profile.skills.map(skill => <span class="skill">{skill}</span>)}</div>
  </section>
  <section class="section" aria-labelledby="publications-title">
    <div class="section-heading"><div><span class="eyebrow">02 / SELECTED WORK</span><h2 id="publications-title">Publications<span class="accent">.</span></h2></div><a class="text-link" href={url('publications/')}>All publications <Icon size={14} /></a></div>
    <div>{publications.map(entry => <Publication entry={entry} />)}</div>
  </section>
  <section class="section" aria-labelledby="projects-title">
    <div class="section-heading"><div><span class="eyebrow">03 / RESEARCH IN PRACTICE</span><h2 id="projects-title">Projects & collaborations<span class="accent">.</span></h2></div><a class="text-link" href={url('projects/')}>All projects <Icon size={14} /></a></div>
    <div class="project-grid">{projects.map((entry, index) => <Project entry={entry} index={index} />)}</div>
  </section>
  {news.length > 0 && <section class="section" aria-labelledby="news-title"><div class="section-heading"><div><span class="eyebrow">04 / RECENTLY</span><h2 id="news-title">Notes & updates<span class="accent">.</span></h2></div><a class="text-link" href={url('news/')}>All updates <Icon size={14} /></a></div><div class="news-list">{news.map(entry => <article><time datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' })}</time><p>{entry.data.link ? <a href={entry.data.link.startsWith('/') ? url(entry.data.link) : entry.data.link}>{entry.data.title} ↗</a> : entry.data.title}</p></article>)}</div></section>}
  <section class="section" id="experience" aria-labelledby="experience-title">
    <div class="section-heading"><div><span class="eyebrow">05 / THE JOURNEY</span><h2 id="experience-title">Experience & recognition<span class="accent">.</span></h2></div><a class="text-link" href={url(profile.cv)}>Full CV <Icon name="download" size={14} /></a></div>
    <div class="timeline">{experiences.map(({entry, Content}) => <article><span class="timeline-period">{entry.data.period}</span><div><h3>{entry.data.title}</h3><p class="institution">{entry.data.institution}</p><div class="prose"><Content /></div></div></article>)}</div>
    <div class="awards">{awards.map(entry => <article><span class="award-year">{entry.data.year}</span><div><h3>{entry.data.title}</h3><p>{entry.data.description}</p></div></article>)}</div>
  </section>
  <section class="contact"><span class="eyebrow">LET’S CONNECT</span><h2>Research is better<br />with good conversations.</h2><p>For collaborations, questions, or a conversation about robotic perception.</p><a class="text-link" href={`mailto:${profile.email}`}>{profile.email}<Icon /></a></section>
</Layout>
