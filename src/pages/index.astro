---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Publication from '../components/Publication.astro';
import Project from '../components/Project.astro';
import { profile } from '../data/profile';
import { url } from '../lib/paths';
const allPublications = (await getCollection('publications')).sort((a, b) => +b.data.date - +a.data.date);
const flagships = allPublications.filter(p => p.data.flagship);
if (flagships.length > 1) throw new Error('Only one publication may have flagship: true.');
const flagship = flagships[0];
const publications = allPublications.filter(p => p.data.featured && p.id !== flagship?.id).slice(0, flagship ? 2 : 3);
const projects = (await getCollection('projects')).sort((a,b) => a.data.order-b.data.order).filter(p => p.data.featured).slice(0, 3);
const news = (await getCollection('news')).sort((a,b) => +b.data.date - +a.data.date).slice(0,5);
const experience = (await getCollection('experience')).sort((a,b) => a.data.order-b.data.order);
const awards = (await getCollection('awards')).sort((a,b) => b.data.year-a.data.year);
const experiences = await Promise.all(experience.map(async entry => ({ entry, ...await render(entry) })));
---
<Layout active="home">
  <section class="hero" aria-labelledby="intro-title">
    <p class="hero-affiliation">{profile.role} · {profile.university}</p>
    <h1 id="intro-title">{profile.headline}</h1>
    <p class="hero-intro">{profile.intro}</p>
    <div class="hero-actions"><a class="button" href={url('publications/')}>View publications</a><a class="text-link" href={`mailto:${profile.email}`}>Contact</a></div>
  </section>
  {(flagship || publications.length > 0) && <section class="section selected-publications" aria-labelledby="publications-title">
    <div class="section-heading"><h2 id="publications-title">Selected publications</h2><a class="text-link" href={url('publications/')}>All publications</a></div>
    {flagship && <Publication entry={flagship} featured />}
    <div class="supporting-publications">{publications.map(entry => <Publication entry={entry} compact />)}</div>
  </section>}
  <section class="section" aria-labelledby="research-title">
    <div class="section-heading"><h2 id="research-title">Research interests</h2></div>
    <div class="interest-grid">{profile.interests.map(interest => <div class="interest"><h3>{interest.title}</h3><p>{interest.description}</p></div>)}</div>
    <p class="skills"><span>Tools & methods:</span> {profile.skills.join(' · ')}</p>
  </section>
  <section class="section" aria-labelledby="projects-title">
    <div class="section-heading"><h2 id="projects-title">Projects & collaborations</h2><a class="text-link" href={url('projects/')}>All projects</a></div>
    <div class="project-grid">{projects.map(entry => <Project entry={entry} />)}</div>
  </section>
  {news.length > 0 && <section class="section" aria-labelledby="news-title"><div class="section-heading"><h2 id="news-title">News</h2><a class="text-link" href={url('news/')}>All updates</a></div><div class="news-list">{news.map(entry => <article><time datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' })}</time><p>{entry.data.link ? <a href={entry.data.link.startsWith('/') ? url(entry.data.link) : entry.data.link}>{entry.data.title}</a> : entry.data.title}</p></article>)}</div></section>}
  <section class="section" id="experience" aria-labelledby="experience-title">
    <div class="section-heading"><h2 id="experience-title">Experience & recognition</h2><a class="text-link" href={url(profile.cv)}>Download CV</a></div>
    <div class="timeline">{experiences.map(({entry, Content}) => <article><span class="timeline-period">{entry.data.period}</span><div><h3>{entry.data.title}</h3><p class="institution">{entry.data.institution}</p><div class="prose"><Content /></div></div></article>)}</div>
    <div class="awards">{awards.map(entry => <article><span class="award-year">{entry.data.year}</span><div><h3>{entry.data.title}</h3><p>{entry.data.description}</p></div></article>)}</div>
  </section>
  <section class="contact" aria-labelledby="contact-title"><h2 id="contact-title">Contact</h2><p>For research collaborations or questions about robotic perception.</p><a class="text-link" href={`mailto:${profile.email}`}>{profile.email}</a></section>
</Layout>
