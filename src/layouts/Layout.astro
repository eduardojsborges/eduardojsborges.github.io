---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import '../styles/theme.css';
import { profile } from '../data/profile';
import { url } from '../lib/paths';
import Icon from '../components/Icon.astro';
interface Props { title?: string; description?: string; active?: string }
const { title = 'Robotics & computer vision', description = profile.intro, active } = Astro.props;
const nav = [
  { label: 'Home', href: '', id: 'home' },
  { label: 'Publications', href: 'publications/', id: 'publications' },
  { label: 'Projects', href: 'projects/', id: 'projects' },
];
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="black" />
    <meta property="og:title" content={`${title} — ${profile.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <title>{title} — {profile.name}</title>
    <script is:inline>
      try { const t = sessionStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <aside class="sidebar" aria-label="Profile and navigation">
        <a class="identity" href={url()} aria-label="Eduardo Borges home">
          <img class="portrait" src={url(profile.portrait)} alt="Eduardo Borges" width="648" height="648" fetchpriority="high" />
          <div><span class="identity-name">{profile.name}</span><span class="identity-field">{profile.field}</span></div>
        </a>
        <p class="sidebar-bio">{profile.role}<br /><a href={profile.institutionUrl}>{profile.institution}</a><br />{profile.university}</p>
        <p class="location"><Icon name="pin" size={14} />{profile.location}</p>
        <details class="mobile-menu" id="mobile-menu">
          <summary>Menu <Icon name="menu" /></summary>
          <div class="mobile-panel">
            <nav aria-label="Mobile navigation">{nav.map(item => <a href={url(item.href)} aria-current={active === item.id ? 'page' : undefined}>{item.label}</a>)}</nav>
            <a class="cv-link" href={url(profile.cv)}>Download CV <Icon name="download" size={18} /></a>
            <a class="email-link" href={`mailto:${profile.email}`}>Email</a>
            <div class="social-links">{profile.socials.map(social => <a href={social.url}>{social.label}</a>)}</div>
            <button data-theme-toggle class="theme-button" aria-label="Switch colour theme" hidden><Icon name="sun" />Colour theme</button>
          </div>
        </details>
        <nav class="desktop-nav" aria-label="Main navigation">
          {nav.map(item => <a href={url(item.href)} aria-current={active === item.id ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <a class="cv-link" href={url(profile.cv)}>Download CV <Icon name="download" size={16} /></a>
        <div class="sidebar-bottom">
          <a class="email-link" href={`mailto:${profile.email}`}><Icon name="mail" size={18} />Email</a>
          <div class="social-links">{profile.socials.map(social => <a href={social.url} aria-label={social.label}>{social.short}</a>)}</div>
          <button data-theme-toggle class="theme-button" aria-label="Switch colour theme" hidden><Icon name="sun" />Colour theme</button>
        </div>
      </aside>
      <div class="main-column">
        <main id="main" tabindex="-1"><slot /></main>
        <footer><span>© {new Date().getFullYear()} {profile.name}</span><a href={`mailto:${profile.email}`}>Email</a></footer>
      </div>
    </div>
    <script>
      const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
      function updateLabel() {
        const dark = document.documentElement.dataset.theme !== 'light';
        toggles.forEach(toggle => toggle.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} theme`));
        const background = getComputedStyle(document.documentElement).getPropertyValue('--bg').trim();
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', background);
      }
      toggles.forEach(toggle => {
        toggle.hidden = false;
        updateLabel();
        toggle.addEventListener('click', () => {
          const dark = document.documentElement.dataset.theme !== 'light';
          const theme = dark ? 'light' : 'dark';
          document.documentElement.dataset.theme = theme;
          try { sessionStorage.setItem('theme', theme); } catch {}
          updateLabel();
        });
      });
      // Time-based easing feels the same on different refresh rates and stops at rest.
      const glowMedia = matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
      const root = document.documentElement;
      let glowFrame = 0;
      let mouseX = 0;
      let mouseY = 0;
      let glowX = 0;
      let glowY = 0;
      let lastGlowTime = 0;
      let glowInitialized = false;
      function animateGlow(time: number) {
        const elapsed = Math.min(time - lastGlowTime, 64);
        lastGlowTime = time;
        const ease = 1 - Math.exp(-elapsed / 55);
        glowX += (mouseX - glowX) * ease;
        glowY += (mouseY - glowY) * ease;
        const settled = Math.hypot(mouseX - glowX, mouseY - glowY) < .2;
        if (settled) { glowX = mouseX; glowY = mouseY; }
        root.style.setProperty('--cursor-x', `${glowX}px`);
        root.style.setProperty('--cursor-y', `${glowY}px`);
        root.setAttribute('data-cursor-glow', '');
        glowFrame = settled ? 0 : requestAnimationFrame(animateGlow);
      }
      function hideGlow() {
        cancelAnimationFrame(glowFrame);
        glowFrame = 0;
        glowInitialized = false;
        root.removeAttribute('data-cursor-glow');
      }
      document.addEventListener('pointermove', event => {
        if (!glowMedia.matches || event.pointerType !== 'mouse') { hideGlow(); return; }
        mouseX = event.clientX;
        mouseY = event.clientY;
        if (!glowInitialized) {
          glowX = mouseX;
          glowY = mouseY;
          glowInitialized = true;
        }
        if (glowFrame) return;
        lastGlowTime = performance.now();
        glowFrame = requestAnimationFrame(animateGlow);
      }, { passive: true });
      document.documentElement.addEventListener('pointerleave', hideGlow);
      document.addEventListener('pointerdown', event => { if (event.pointerType !== 'mouse') hideGlow(); }, { passive: true });
      window.addEventListener('blur', hideGlow);
      window.addEventListener('pagehide', hideGlow);
      document.addEventListener('visibilitychange', () => { if (document.hidden) hideGlow(); });
      glowMedia.addEventListener('change', hideGlow);
      const menu = document.querySelector<HTMLDetailsElement>('#mobile-menu');
      const menuTrigger = menu?.querySelector('summary');
      menu?.addEventListener('keydown', event => {
        if (event.key === 'Escape') { menu.open = false; menuTrigger?.focus(); }
      });
      menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
      document.addEventListener('click', event => {
        if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
      });
    </script>
  </body>
</html>
