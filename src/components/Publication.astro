---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Citation from './Citation.astro';
import { url } from '../lib/paths';
interface Props { entry: CollectionEntry<'publications'>; expanded?: boolean; featured?: boolean; compact?: boolean }
const { entry, expanded = false, featured = false, compact = false } = Astro.props;
const p = entry.data;
const resource = (value: string) => value.startsWith('/') ? url(value) : value;
const Content = expanded ? (await render(entry)).Content : undefined;
---
<article class:list={['publication', { 'publication-featured': featured, 'publication-compact': compact }]}>
  {featured && p.thumbnail && <figure class="featured-figure">
    <a href={url(p.thumbnail)} aria-label={`View full-size research figure: ${p.title}`}><img src={url(p.thumbnail)} alt={p.thumbnailAlt ?? ''} width="2000" height="647" loading="lazy" /></a>
    {p.thumbnailCaption && <figcaption>{p.thumbnailCaption}</figcaption>}
  </figure>}
  <div class="publication-meta"><span class="venue-label">{p.venueShort ?? p.venue}</span><span>{p.date.getUTCFullYear()}</span>{featured && /Borges/.test(p.authors[0]) && <span>First-author research</span>}</div>
  <h3><a href={url(`publications/${entry.id}/`)}>{p.title}</a></h3>
  <p class="authors">{p.authors.map((author, i) => <>{i > 0 && ', '}{/Borges/.test(author) ? <strong>{author}</strong> : author}</>)}</p>
  {!compact && <p class="publication-summary">{p.summary}</p>}
  <div class="resource-links">
    {p.paperUrl && <a href={resource(p.paperUrl)}>Read paper</a>}
    {p.codeUrl && <a href={resource(p.codeUrl)}>Code</a>}
    {!featured && !compact && <a href={url(`publications/${entry.id}/`)}>Publication details</a>}
  </div>
  {Content && <details class="abstract"><summary>Abstract</summary><div class="prose abstract-body"><Content /></div></details>}
  <details class="citation-disclosure"><summary>Cite this paper</summary><Citation entry={entry} idPrefix={`list-${entry.id}`} /></details>
</article>
