---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/paths';
import Icon from './Icon.astro';
interface Props { entry: CollectionEntry<'projects'>; index?: number }
const { entry, index = 0 } = Astro.props;
const p = entry.data;
---
<article class="project">
  {p.thumbnail && <img class="project-image" src={url(p.thumbnail)} alt={p.thumbnailAlt ?? ''} width="600" height="360" loading="lazy" />}
  <div class="project-topline"><span>PROJECT / {String(index + 1).padStart(2, '0')}</span><span>{p.role}</span></div>
  <h3><a href={url(`projects/${entry.id}/`)}>{p.title}<Icon size={21} /></a></h3>
  <p>{p.summary}</p>
  {p.dates && <span class="muted">{p.dates}</span>}
  <a class="text-link" href={url(`projects/${entry.id}/`)}>Explore project <Icon size={14} /></a>
</article>
