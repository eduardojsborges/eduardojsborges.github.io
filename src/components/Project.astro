---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/paths';
interface Props { entry: CollectionEntry<'projects'>; headingLevel?: 2 | 3 }
const { entry, headingLevel = 3 } = Astro.props;
const p = entry.data;
const Heading = `h${headingLevel}`;
---
<article class="project">
  {p.thumbnail && <img class="project-image" src={url(p.thumbnail)} alt={p.thumbnailAlt ?? ''} width="600" height="360" loading="lazy" />}
  <Heading><a href={url(`projects/${entry.id}/`)}>{p.title}</a></Heading>
  <p class="project-role">{p.role}{p.dates && ` · ${p.dates}`}</p>
  <p>{p.summary}</p>
</article>
