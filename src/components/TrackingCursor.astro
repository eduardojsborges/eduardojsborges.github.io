<div class="tracking-cursor" aria-hidden="true" hidden>
  <div class="tracking-cursor__brackets">
    <span></span><span></span><span></span><span></span>
  </div>
  <span class="tracking-cursor__dot"></span>
</div>

<script>
  const reticle = document.querySelector<HTMLElement>('.tracking-cursor');
  const dot = reticle?.querySelector<HTMLElement>('.tracking-cursor__dot');
  const brackets = reticle?.querySelector<HTMLElement>('.tracking-cursor__brackets');
  const desktopMouse = matchMedia('screen and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) and (forced-colors: none)');
  const root = document.documentElement;
  const interactive = 'a[href], button, summary, [role="button"], [role="link"]';
  const followFactor = .18;
  const frameDuration = 1000 / 60;
  const handoffKey = 'portfolio:cursor-handoff';
  const handoffLifetime = 10_000;

  if (reticle && dot && brackets && CSS.supports('cursor', 'none')) {
    const marker = reticle;
    const center = dot;
    const corners = brackets;
    let point: { x: number; y: number } | null = null;
    let bracketX = 0;
    let bracketY = 0;
    let frame = 0;
    let lastFrameTime = 0;
    let handoffPending = false;

    function reset() {
      cancelAnimationFrame(frame);
      frame = 0;
      point = null;
      root.removeAttribute('data-tracking-cursor');
      marker.hidden = true;
      marker.removeAttribute('data-expanded');
    }

    function place(element: HTMLElement, x: number, y: number) {
      element.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`;
    }

    function follow(time: number) {
      frame = 0;
      if (!point) return;

      // Apply the same easing at different display refresh rates.
      const elapsed = Math.min(Math.max(time - lastFrameTime, 0), 50);
      const factor = 1 - (1 - followFactor) ** (elapsed / frameDuration);
      lastFrameTime = time;
      bracketX += (point.x - bracketX) * factor;
      bracketY += (point.y - bracketY) * factor;

      if (Math.hypot(point.x - bracketX, point.y - bracketY) < .35) {
        bracketX = point.x;
        bracketY = point.y;
      } else {
        frame = requestAnimationFrame(follow);
      }
      place(corners, bracketX, bracketY);
    }

    function updateHover(target: Element | null) {
      const control = target?.closest(interactive);
      const disabled = control?.closest(':disabled, [aria-disabled="true"]');
      marker.toggleAttribute('data-expanded', Boolean(control && !disabled));
    }

    function showAt(x: number, y: number, target: Element | null) {
      if (!desktopMouse.matches || !Number.isFinite(x) || !Number.isFinite(y) ||
          x < 0 || y < 0 || x >= root.clientWidth || y >= root.clientHeight) {
        reset();
        return;
      }

      point = { x, y };
      place(center, x, y);
      updateHover(target);

      if (marker.hidden) {
        bracketX = point.x;
        bracketY = point.y;
        place(corners, bracketX, bracketY);
        marker.hidden = false;
        if (getComputedStyle(marker).position !== 'fixed') {
          reset();
          return;
        }
        root.setAttribute('data-tracking-cursor', '');
      }

      if (!frame && (bracketX !== point.x || bracketY !== point.y)) {
        lastFrameTime = performance.now();
        frame = requestAnimationFrame(follow);
      }
    }

    function track(event: PointerEvent) {
      if (event.pointerType !== 'mouse') {
        leaveViewport();
        return;
      }
      showAt(event.clientX, event.clientY, event.target instanceof Element ? event.target : null);
    }

    function saveHandoff(event: MouseEvent) {
      if (!point || !desktopMouse.matches || !event.isTrusted || event.defaultPrevented ||
          event.button !== 0 || !event.detail || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      if ('pointerType' in event && event.pointerType !== 'mouse') return;
      const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href]') : null;
      if (!link || link.origin !== location.origin || link.hasAttribute('download') ||
          (link.target && link.target.toLowerCase() !== '_self')) return;
      if (link.pathname === location.pathname && link.search === location.search) return;

      try {
        sessionStorage.setItem(handoffKey, JSON.stringify({
          destination: link.href,
          x: event.clientX,
          y: event.clientY,
          expires: Date.now() + handoffLifetime,
        }));
        handoffPending = true;
      } catch { /* Storage can be unavailable. Pointer events still drive the reticle. */ }
    }

    function restoreHandoff() {
      try {
        const saved = sessionStorage.getItem(handoffKey);
        if (!saved) return;
        sessionStorage.removeItem(handoffKey);
        const { destination, x, y, expires } = JSON.parse(saved);
        if (destination !== location.href || !(expires > Date.now()) || document.hidden || !desktopMouse.matches) return;
        if (typeof x !== 'number' || typeof y !== 'number') return;
        showAt(x, y, document.elementFromPoint(x, y));
      } catch { /* An unavailable or invalid handoff leaves the native pointer in place. */ }
    }

    function leaveViewport() {
      if (handoffPending) {
        handoffPending = false;
        try { sessionStorage.removeItem(handoffKey); } catch {}
      }
      reset();
    }

    function refreshTarget() {
      if (point) updateHover(document.elementFromPoint(point.x, point.y));
    }

    document.addEventListener('pointerover', track, { passive: true });
    document.addEventListener('pointermove', track, { passive: true });
    document.addEventListener('pointerdown', track, { passive: true });
    document.addEventListener('pointerup', track, { passive: true });
    document.addEventListener('pointercancel', reset);
    root.addEventListener('pointerleave', leaveViewport);
    document.addEventListener('scroll', refreshTarget, { capture: true, passive: true });
    window.addEventListener('resize', reset);
    window.addEventListener('blur', reset);
    window.addEventListener('pagehide', reset);
    window.addEventListener('click', saveHandoff, { passive: true });
    window.addEventListener('pageshow', restoreHandoff);
    document.addEventListener('visibilitychange', () => { if (document.hidden) reset(); });
    desktopMouse.addEventListener('change', reset);
    restoreHandoff();
  }
</script>

<style is:global>
  .tracking-cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 101;
    pointer-events: none;
    color: var(--accent);
  }

  .tracking-cursor__dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
  }

  .tracking-cursor__brackets {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--reticle-size);
    height: var(--reticle-size);
    transition: width var(--reticle-transition) ease-out, height var(--reticle-transition) ease-out;
  }

  .tracking-cursor[data-expanded] .tracking-cursor__brackets {
    width: var(--reticle-hover-size);
    height: var(--reticle-hover-size);
  }

  .tracking-cursor__brackets span {
    position: absolute;
    width: 7px;
    height: 7px;
    border: solid currentColor;
    border-width: 0;
  }

  .tracking-cursor__brackets span:nth-child(1) { top: 0; left: 0; border-width: 1px 0 0 1px; }
  .tracking-cursor__brackets span:nth-child(2) { top: 0; right: 0; border-width: 1px 1px 0 0; }
  .tracking-cursor__brackets span:nth-child(3) { bottom: 0; left: 0; border-width: 0 0 1px 1px; }
  .tracking-cursor__brackets span:nth-child(4) { bottom: 0; right: 0; border-width: 0 1px 1px 0; }

  @media screen and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) and (forced-colors: none) {
    html[data-tracking-cursor], html[data-tracking-cursor] :where(*) { cursor: none; }
  }

  @media not screen, (hover: none), (pointer: coarse), (pointer: none), (prefers-reduced-motion: reduce), (forced-colors: active) {
    .tracking-cursor { display: none; }
  }
</style>
